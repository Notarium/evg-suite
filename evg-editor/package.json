{
  "name": "evg-editor",
  "version": "0.0.1",
  "private": true,
  "description": "EVG Editor - Electron + React + TypeScript + Vite + pnpm",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dist": "electron-vite build && electron-builder --win",
    "preview-dist": "electron-vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@11.23.0",
  "build": {
    "appId": "com.notarium.evg-editor",
    "productName": "EVG Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false
  }
}
